# Copie este arquivo para .env.local e preencha com os valores do seu projeto
# Supabase: Dashboard > Settings > API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role: NUNCA expor no client. Usado só em rotas server-side (ex: cron).
SUPABASE_SERVICE_ROLE_KEY=

# String aleatória para proteger a rota de cron (marcar tarefas atrasadas)
CRON_SECRET=
